{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "cache": false,
      "outputs": []
    },
    "generate:openapi": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["openapi/openapi.json"]
    },
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    }
  }
}
